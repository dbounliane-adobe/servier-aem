        {
          "id": "5",
          "name": "therapeutic-areas",
          "selector": [
            ".wp-block-banner-img-cta-multiple-v2"
          ],
          "style": "highlight",
          "blocks": [
            "section-intro",
            "topic-cards"
          ],
          "defaultContent": []
