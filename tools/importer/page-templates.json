          "style": null,
          "blocks": [
            "campaign-hero"
          ],
          "defaultContent": []
        },
        {
          "id": "2",
          "name": "featured-content",
          "selector": [
            "#main > article.featured-content"
          ],
          "style": null,
          "blocks": [
            "editorial-feature"
          ],
          "defaultContent": []
